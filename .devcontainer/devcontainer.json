{ 
  "name": "C++ Lab Environment", 
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "customizations": { 
    "vscode": { 
      "extensions": [ 
        "ms-vscode.cpptools", 
        "ms-vscode.cmake-tools" 
      ] 
    } 
  },
  "runArgs": [ 
    "--cap-add=SYS_PTRACE", 
    "--security-opt=seccomp=unconfined" 
  ], 
  "remoteUser": "vscode" 
}
